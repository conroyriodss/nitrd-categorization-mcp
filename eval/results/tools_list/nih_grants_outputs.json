  {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true,
      "title": "Get DataCite outputs for an NIH award"
    },
    "description": "List datasets and software with DataCite DOIs that cite this award.\n\nIn the MVP the DataCite table is not loaded yet, so status is\n\"not_available\" and outputs is null. Treat that as unknown, not as\nevidence the award produced no data outputs.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "core_project_num": {
          "description": "NIH core project number shared by all years of an award, e.g. U24AI171008 (activity + IC + serial; no type prefix or -yr suffix). Publications and data outputs are linked at this level.",
          "maxLength": 40,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "core_project_num"
      ],
      "type": "object"
    },
    "meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "name": "outputs_get_project_datacite",
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "core_project_num": {
          "type": "string"
        },
        "outputs": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "award_number_matched": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Funding-reference award number that linked this DOI to the award."
                  },
                  "doi": {
                    "type": "string"
                  },
                  "match_confidence": {
                    "description": "DataCite v2 tier: funder ID + award = high; name + award = medium.",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ],
                    "type": "string"
                  },
                  "publication_year": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "resource_type": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "resource_type_general": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "e.g. Dataset, Software."
                  },
                  "title": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "doi",
                  "title",
                  "resource_type_general",
                  "resource_type",
                  "publication_year",
                  "award_number_matched",
                  "match_confidence"
                ],
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when not_available; [] when loaded and nothing matched."
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why status is not_available."
        },
        "source": {
          "additionalProperties": false,
          "description": "Where an answer came from. Every read result carries one.",
          "properties": {
            "snapshot": {
              "default": "Fixed snapshot of public NIH ExPORTER FY2015-2023, iCite and PubMed records, loaded 2026-10; no live API calls.",
              "description": "Data vintage. Results do not reflect later NIH updates.",
              "type": "string"
            },
            "tables": {
              "description": "Fully qualified Databricks tables read.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "tables"
          ],
          "type": "object"
        },
        "status": {
          "description": "not_available = table not loaded (unknown), NOT 'no outputs'.",
          "enum": [
            "available",
            "not_available"
          ],
          "type": "string"
        }
      },
      "required": [
        "core_project_num",
        "status",
        "reason",
        "outputs",
        "source"
      ],
      "type": "object"
    },
    "title": "Get DataCite outputs for an NIH award"
  },
  {
