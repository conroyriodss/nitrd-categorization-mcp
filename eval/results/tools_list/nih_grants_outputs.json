[
  {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true,
      "title": "Find a cohort by IC + activity"
    },
    "description": "Select a cohort of public NIH records by administering IC, activity\ncode and fiscal year, or list the IC x activity combinations available.\n\nWith ic + activity: the matching records (ordered by appl_id), the total\nbefore the limit, and the exact SQL that ran. With ic only, or neither:\nthe combinations that have at least one record that year, for picking a\ncohort. Check total_matching before classifying a cohort. FY2022-2026\nare refused (reserved for validation and sealed scoring).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "anyOf": [
            {
              "maxLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Activity code, e.g. U01, R01. Give it with ic to get the cohort; omit it to list the activity codes available."
        },
        "confirm_large": {
          "default": false,
          "description": "Required to set limit above 50.",
          "type": "boolean"
        },
        "fy": {
          "description": "NIH fiscal year, 2015-2021. FY2022-2026 are reserved for validation and sealed scoring and are refused.",
          "minimum": 2015,
          "type": "integer"
        },
        "ic": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Administering IC: NIH abbreviation (e.g. NIBIB) or ExPORTER two-letter code (e.g. EB). Omit, with activity, to list every IC."
        },
        "limit": {
          "default": 50,
          "description": "Cohort mode: max records to return. Default 50; 51-200 needs confirm_large=true; above 200 or below 1 is rejected.",
          "type": "integer"
        }
      },
      "required": [
        "fy"
      ],
      "type": "object"
    },
    "meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "name": "outputs_find_cohort",
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "administering_ic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Code queried, if any."
        },
        "bounds": {
          "additionalProperties": false,
          "properties": {
            "confirm_above": {
              "default": 50,
              "type": "integer"
            },
            "default_limit": {
              "default": 50,
              "type": "integer"
            },
            "hard_cap": {
              "default": 200,
              "type": "integer"
            },
            "max_fy": {
              "default": 2021,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "combinations": {
          "description": "Combinations mode: ordered by IC code, activity; else empty.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "activity": {
                "type": "string"
              },
              "administering_ic": {
                "description": "ExPORTER code, e.g. EB.",
                "type": "string"
              },
              "ic": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "NIH abbreviation, e.g. NIBIB, if known."
              },
              "records": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "administering_ic",
              "ic",
              "activity",
              "records"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "fy": {
          "type": "integer"
        },
        "ic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Abbreviation as resolved, if any."
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cohort mode only."
        },
        "mode": {
          "enum": [
            "cohort",
            "combinations"
          ],
          "type": "string"
        },
        "projects": {
          "description": "Cohort mode: ordered by appl_id ascending; empty otherwise.",
          "items": {
            "additionalProperties": false,
            "description": "One fiscal-year application record in the cohort.",
            "properties": {
              "activity": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "administering_ic": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "ExPORTER code, e.g. EB."
              },
              "appl_id": {
                "description": "Pass to outputs_get_project_detail / classifier.",
                "type": "integer"
              },
              "core_project_num": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "full_project_num": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fy": {
                "type": "integer"
              },
              "ic": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "NIH abbreviation, e.g. NIBIB, if known."
              },
              "pi_names": {
                "description": "Contact PI first, as in ExPORTER.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "reporter_url": {
                "description": "Public NIH RePORTER page for the record.",
                "type": "string"
              },
              "subproject_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Set for a multi-project award component; null for the parent."
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "total_cost": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "appl_id",
              "fy",
              "full_project_num",
              "core_project_num",
              "subproject_id",
              "title",
              "activity",
              "administering_ic",
              "ic",
              "pi_names",
              "total_cost",
              "reporter_url"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "query": {
          "additionalProperties": false,
          "description": "The exact statement this call ran and its bound parameters.",
          "properties": {
            "params": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "object"
            },
            "sql": {
              "type": "string"
            }
          },
          "required": [
            "sql",
            "params"
          ],
          "type": "object"
        },
        "returned": {
          "description": "Projects returned (cohort) or combinations returned.",
          "type": "integer"
        },
        "source": {
          "additionalProperties": false,
          "description": "Where an answer came from. Every read result carries one.",
          "properties": {
            "snapshot": {
              "default": "Fixed snapshot of public NIH ExPORTER FY2015-2023, iCite and PubMed records, loaded 2026-10; no live API calls.",
              "description": "Data vintage. Results do not reflect later NIH updates.",
              "type": "string"
            },
            "tables": {
              "description": "Fully qualified Databricks tables read.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "tables"
          ],
          "type": "object"
        },
        "total_matching": {
          "description": "Records matching before any limit (both modes).",
          "type": "integer"
        },
        "truncated": {
          "description": "Cohort mode: total_matching > returned.",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "fy",
        "ic",
        "administering_ic",
        "activity",
        "limit",
        "total_matching",
        "returned",
        "truncated",
        "projects",
        "combinations",
        "query",
        "source"
      ],
      "type": "object"
    },
    "title": "Find a cohort by IC + activity"
  },
  {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true,
      "title": "Find NIH projects by category"
    },
    "description": "List public NIH projects tagged with a spending category in one fiscal year.\n\nUse it to find candidate projects by category and year (for a cohort\nby IC and activity code, use outputs_find_cohort). Each result gives the\nappl_id (for outputs_get_project_detail and the classifier tools) and\nthe core_project_num (for publications, DataCite and intensity).\nAn unknown category name is an error; a valid category with no rows\nthat year returns an empty list.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "NIH RCDC spending category NAME exactly as published in ExPORTER (matched case-insensitively), e.g. 'Networking and Information Technology R&D (NITRD)'. Names, not numeric RCDC IDs. For NITRD the pre-FY2019 name without ' (NITRD)' is matched too.",
          "maxLength": 200,
          "minLength": 2,
          "type": "string"
        },
        "fy": {
          "description": "NIH fiscal year, 2015-2023 (loaded ExPORTER years).",
          "maximum": 2023,
          "minimum": 2015,
          "type": "integer"
        },
        "limit": {
          "default": 50,
          "description": "Max projects to return (1-500).",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "category",
        "fy"
      ],
      "type": "object"
    },
    "meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "name": "outputs_find_projects",
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Category name as matched in the data.",
          "type": "string"
        },
        "fy": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "projects": {
          "description": "Ordered by appl_id ascending (stable across calls).",
          "items": {
            "additionalProperties": false,
            "description": "One fiscal-year application record.",
            "properties": {
              "activity": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Activity code, e.g. R01, U24."
              },
              "administering_ic": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Two-letter IC code, e.g. AI, LM."
              },
              "appl_id": {
                "description": "Application ID; pass to the detail/classifier tools.",
                "type": "integer"
              },
              "core_project_num": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Award-level number for publications/DataCite/intensity tools."
              },
              "full_project_num": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "e.g. 5U24AI171008-02."
              },
              "fy": {
                "type": "integer"
              },
              "subproject_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Set for a multi-project award component; null for the parent."
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "total_cost": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Total cost in USD for this record, if published."
              }
            },
            "required": [
              "appl_id",
              "fy",
              "full_project_num",
              "core_project_num",
              "subproject_id",
              "title",
              "activity",
              "administering_ic",
              "total_cost"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "returned": {
          "type": "integer"
        },
        "source": {
          "additionalProperties": false,
          "description": "Where an answer came from. Every read result carries one.",
          "properties": {
            "snapshot": {
              "default": "Fixed snapshot of public NIH ExPORTER FY2015-2023, iCite and PubMed records, loaded 2026-10; no live API calls.",
              "description": "Data vintage. Results do not reflect later NIH updates.",
              "type": "string"
            },
            "tables": {
              "description": "Fully qualified Databricks tables read.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "tables"
          ],
          "type": "object"
        },
        "total_matching": {
          "description": "Records in the category for this year.",
          "type": "integer"
        },
        "truncated": {
          "description": "True when total_matching > returned.",
