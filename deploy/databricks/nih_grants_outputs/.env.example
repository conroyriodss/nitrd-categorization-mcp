# Per-App deploy settings for nih-grants-outputs. No secrets.
# cp deploy/databricks/nih_grants_outputs/.env.example deploy/databricks/nih_grants_outputs/.env
SERVER=nih_grants_outputs
APP_NAME=mcp-nih-grants-outputs
# Absolute workspace path the staged source is synced to. Replace <you>.
SOURCE_CODE_PATH=/Workspace/Users/<you>/apps/mcp-nih-grants-outputs
