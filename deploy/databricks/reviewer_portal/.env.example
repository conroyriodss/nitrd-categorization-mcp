# Per-App deploy settings for reviewer-portal. No secrets.
# cp deploy/databricks/reviewer_portal/.env.example deploy/databricks/reviewer_portal/.env
SERVER=reviewer_portal
APP_NAME=mcp-nitrd-reviewer-portal
# Absolute workspace path the staged source is synced to. Replace <you>.
SOURCE_CODE_PATH=/Workspace/Users/<you>/apps/mcp-nitrd-reviewer-portal
