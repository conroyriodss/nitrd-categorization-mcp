# Databricks Apps deployment configuration for your MCP server.
#
# Copy to .env and fill in, then:
#   set -a; source deploy/databricks/.env; set +a
# before running the deploy script.
#
# This file contains NO secrets. Databricks authentication is handled by the
# Databricks CLI (an OAuth login or a DATABRICKS_TOKEN in your environment/CLI
# profile), NOT stored here.

# --- Databricks workspace -----------------------------------------------------
# Your workspace URL. Also settable via the CLI profile; if set here the deploy
# script passes it through.
#   DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_HOST=

# CLI profile to use (from `databricks auth login` / ~/.databrickscfg).
# This MUST match the profile name you chose during `databricks auth login`.
# NOTE: `databricks auth login` defaults the profile name to your workspace host
# (or whatever you type at its prompt), NOT "DEFAULT". Run `databricks auth
# profiles` to see your profile names and set this to the one for this workspace.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# --- App identity -------------------------------------------------------------
# Per-App settings (SERVER, APP_NAME, SOURCE_CODE_PATH) live in each server's
# own file: deploy/databricks/<SERVER>/.env.example. Source this shared file
# first, then the server file.
