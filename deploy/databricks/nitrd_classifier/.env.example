# Per-App deploy settings for nitrd-classifier. No secrets.
# cp deploy/databricks/nitrd_classifier/.env.example deploy/databricks/nitrd_classifier/.env
SERVER=nitrd_classifier
APP_NAME=mcp-nitrd-classifier
# Absolute workspace path the staged source is synced to. Replace <you>.
SOURCE_CODE_PATH=/Workspace/Users/<you>/apps/mcp-nitrd-classifier
