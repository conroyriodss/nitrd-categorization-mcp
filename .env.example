# Local settings for the three MCP servers. Copy to .env (git-ignored):
#   cp .env.example .env
#   set -a; source .env; set +a
# No secrets belong in the committed example. Never commit the filled-in .env.
#
# Two kinds of variables:
#   * Per-server (OUTPUTS_*, CLASSIFIER_*, PORTAL_*): read from .env by each
#     server's src/<server>/config.py (pydantic-settings, env_prefix).
#   * Shared (DATABRICKS_*, NITRD_*): read from the PROCESS ENVIRONMENT by
#     databricks-sdk and src/shared/, not from .env. Source this file (above)
#     so they reach the process.
#
# A generic MCP_TRANSPORT / MCP_HOST / MCP_PORT is NOT read by any server.
# On Databricks Apps none of the transport settings matter: app.py serves
# streamable HTTP on DATABRICKS_APP_PORT whenever the platform injects it.

# --- Databricks access (shared) ----------------------------------------------
# Authentication via databricks-sdk's default chain. Use EITHER host + token
# OR a CLI profile. Leave unused lines commented out: an exported EMPTY value
# overrides a working CLI login.
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<personal-access-token>
# DATABRICKS_CONFIG_PROFILE=<profile-name>

# SQL warehouse for all three servers, used when the per-server
# <PREFIX>_DATABRICKS_WAREHOUSE_ID below is empty. Also switches tests to live mode.
# DATABRICKS_WAREHOUSE_ID=<warehouse-id>

# Table location (defaults shown; see src/shared/tables.py).
# NITRD_DATA_SCHEMA=users.conroyri
# NITRD_TABLE_PREFIX=nitrd_hackathon_v1_

# --- nih-grants-outputs (src/nih_grants_outputs/config.py) -------------------
# "stdio" (launched by an MCP client) or "streamable-http" (http://host:port/mcp)
OUTPUTS_MCP_TRANSPORT=stdio
OUTPUTS_MCP_HOST=0.0.0.0
OUTPUTS_MCP_PORT=8001
OUTPUTS_DATABRICKS_WAREHOUSE_ID=

# --- nitrd-classifier (src/nitrd_classifier/config.py) -----------------------
CLASSIFIER_MCP_TRANSPORT=stdio
CLASSIFIER_MCP_HOST=0.0.0.0
CLASSIFIER_MCP_PORT=8002
CLASSIFIER_DATABRICKS_WAREHOUSE_ID=
# Optional overrides (defaults are the committed artifacts under resources/):
# CLASSIFIER_PARENT_MODEL_PATH=src/nitrd_classifier/resources/parent_model.joblib
# CLASSIFIER_SCOPE_DIR=src/nitrd_classifier/resources/scope

# --- reviewer-portal (src/reviewer_portal/config.py) -------------------------
PORTAL_MCP_TRANSPORT=stdio
PORTAL_MCP_HOST=0.0.0.0
PORTAL_MCP_PORT=8003
PORTAL_DATABRICKS_WAREHOUSE_ID=
# Optional override of the fictional persona roster:
# PORTAL_PERSONAS_PATH=src/reviewer_portal/resources/personas.json

# --- Tests only ---------------------------------------------------------------
# Enable live sandbox-write tests (they delete their own rows):
# PORTAL_LIVE_WRITE_TESTS=1
